    "core-js": "^3.6.5",
    "echarts": "^5.1.1",
    "echarts-liquidfill": "^3.0.0",
    "element-ui": "^2.15.7",
    "html2canvas": "^1.4.1",
    "js-base64": "^3.4.5",
    "js-cookie": "^2.2.1",
    "js-md5": "^0.7.3",
    "jshint": "^2.12.0",
    "jsonlint": "^1.6.3",
